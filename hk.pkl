amends "package://github.com/jdx/hk/releases/download/v2.12.0/hk@2.12.0#/Config.pkl"

import "package://github.com/jdx/hk/releases/download/v2.12.0/hk@2.12.0#/Builtins.pkl"

min_hk_version = "2.12.0"

hooks {
  ["commit-msg"] {
    steps {
      ["conventional-commit"] = Builtins.check_conventional_commit
    }
  }
}

exclude = List("vendor", "vendored", "third_party", "third-party", ".zig-cache", "zig-out", "zig-pkg", "target", "src/repos/template")

// Top-level steps also form the pre-commit hook. Steps in the "harness"
// profile are slow and run only on demand: `mise run check:harness`.
local harness = List("harness")

steps {
  ["hk-config"] {
    glob = List("hk.pkl", "mise.toml", "mise.lock")
    check = "hk validate --deny-warnings"
  }
  ["zig-fmt"] {
    glob = "*.zig"
    check = "zig fmt --check {{files}}"
    fix = "zig fmt {{files}}"
  }
  ["python-ast"] = Builtins.python_check_ast
  ["shellcheck"] = Builtins.shellcheck
  ["zig-test"] {
    check = "mise run test"
    depends = "zig-fmt"
  }
  ["test-harness"] {
    profiles = harness
    check = "mise run test:harness"
  }
  ["zig-release"] {
    profiles = harness
    check = "mise run build:release"
    depends = "zig-test"
  }
  ["command-adapters"] {
    profiles = harness
    check = "mise run test:adapters"
    depends = "zig-test"
  }
  ["command-regressions"] {
    profiles = harness
    check = "mise run test:commands"
    depends = "zig-release"
  }
  ["terminal-regressions"] {
    profiles = harness
    check = "mise run test:terminal"
    depends = "command-regressions"
  }
  ["picker-regressions"] {
    profiles = harness
    check = "mise run test:picker:regressions"
    depends = "zig-test"
  }
}
